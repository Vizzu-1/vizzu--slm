    <!-- 1: FONE BLUETOOTH TWS -->
    <div class="pc feat reveal">
      <div class="pimg">
        <svg viewBox="0 0 600 240" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
          <defs>
