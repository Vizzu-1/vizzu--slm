bash

cat > /mnt/user-data/outputs/vizzu-slm.html << 'HTMLEOF'
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VIZZU SLM — Achadinhos com Entrega Rápida em SLM</title>
<meta name="description" content="Gadgets modernos e utilidades virais com entrega rápida em São Lourenço da Mata - PE. Compre pelo WhatsApp!">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cabinet+Grotesk:wght@400;500;700;800;900&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#0A0A0A;--s1:#141414;--s2:#1C1C1C;--purple:#8B2CF5;--pl:#A855F7;--orange:#FF6B00;--ol:#FF8C38;--green:#22C55E;--pg:rgba(139,44,245,.22);--og:rgba(255,107,0,.18);--text:#F2F2F2;--mu:#777;--mu2:#444;--bd:rgba(255,255,255,.07);--fd:'Cabinet Grotesk',sans-serif;--fb:'Instrument Sans',sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--fb);-webkit-font-smoothing:antialiased;overflow-x:hidden}
body::after{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");pointer-events:none;z-index:9999;opacity:.5}
nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:14px 20px;background:rgba(10,10,10,.9);backdrop-filter:blur(24px) saturate(180%);border-bottom:1px solid var(--bd)}
.nav-logo{display:flex;align-items:center;gap:9px;text-decoration:none}
.logo-mark{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,var(--purple),var(--orange));display:flex;align-items:center;justify-content:center;font-family:var(--fd);font-weight:900;font-size:13px;color:#fff;box-shadow:0 0 18px var(--pg);flex-shrink:0}
.logo-text{font-family:var(--fd);font-weight:800;font-size:15px;letter-spacing:.5px}
.nav-right{display:flex;align-items:center;gap:8px}
.nav-wa{display:flex;align-items:center;gap:6px;background:rgba(37,211,102,.12);border:1px solid rgba(37,211,102,.25);color:#4ade80;border-radius:100px;padding:7px 13px;font-size:12px;font-weight:600;text-decoration:none;transition:all .2s}
.nav-wa:hover{background:rgba(37,211,102,.2)}
.nav-cta{background:var(--purple);color:#fff;border:none;border-radius:100px;padding:8px 18px;font-family:var(--fb);font-size:13px;font-weight:600;cursor:pointer;text-decoration:none;box-shadow:0 0 20px var(--pg);transition:all .2s}
.nav-cta:hover{background:var(--pl);transform:translateY(-1px)}
.hero{position:relative;min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:110px 24px 80px;overflow:hidden;text-align:center}
.hg1{position:absolute;width:600px;height:400px;background:radial-gradient(ellipse,rgba(139,44,245,.18) 0%,transparent 70%);top:-80px;left:50%;transform:translateX(-50%);pointer-events:none}
.hg2{position:absolute;width:320px;height:320px;background:radial-gradient(circle,rgba(255,107,0,.13) 0%,transparent 70%);bottom:60px;right:-40px;pointer-events:none}
.hg3{position:absolute;width:200px;height:200px;background:radial-gradient(circle,rgba(255,107,0,.09) 0%,transparent 70%);bottom:100px;left:-30px;pointer-events:none}
.float-icons{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.fi{position:absolute;font-size:20px;opacity:.09;animation:floatA linear infinite}
.fi1{left:7%;top:28%;animation-duration:20s}.fi2{left:88%;top:18%;animation-duration:25s;animation-delay:-6s}.fi3{left:12%;top:68%;animation-duration:17s;animation-delay:-3s}.fi4{left:80%;top:72%;animation-duration:22s;animation-delay:-9s}.fi5{left:48%;top:12%;animation-duration:28s;animation-delay:-2s}.fi6{left:72%;top:48%;animation-duration:18s;animation-delay:-12s}
@keyframes floatA{0%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-28px) rotate(8deg)}100%{transform:translateY(0) rotate(0deg)}}
.hero-badge{display:inline-flex;align-items:center;gap:7px;background:rgba(139,44,245,.1);border:1px solid rgba(139,44,245,.28);border-radius:100px;padding:7px 18px;font-size:12px;font-weight:500;color:#c084fc;letter-spacing:.3px;margin-bottom:28px;animation:fadeUp .7s ease both}
.bdot{width:6px;height:6px;border-radius:50%;background:var(--pl);box-shadow:0 0 8px var(--pl);animation:blink 2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.hero-logo{width:82px;height:82px;border-radius:22px;position:relative;display:flex;align-items:center;justify-content:center;margin:0 auto 28px;animation:fadeUp .7s .08s ease both;background:var(--s2)}
.hero-logo::before{content:'';position:absolute;inset:-2px;border-radius:24px;background:linear-gradient(135deg,var(--purple),var(--orange));z-index:-1;box-shadow:0 0 40px var(--pg),0 0 20px var(--og)}
.hli{font-family:var(--fd);font-weight:900;font-size:20px;background:linear-gradient(135deg,#c084fc,var(--ol));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
h1{font-family:var(--fd);font-weight:900;font-size:clamp(28px,8.5vw,56px);line-height:1.08;letter-spacing:-1.5px;max-width:680px;margin:0 auto 18px;animation:fadeUp .7s .15s ease both}
h1 em{font-style:normal;background:linear-gradient(95deg,#c084fc 0%,var(--ol) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero-sub{font-size:clamp(15px,3.8vw,17px);color:var(--mu);max-width:380px;line-height:1.65;margin:0 auto 36px;animation:fadeUp .7s .22s ease both}
.hero-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;animation:fadeUp .7s .3s ease both}
.btn-p{background:linear-gradient(135deg,var(--purple),#6D00CC);color:#fff;border:none;border-radius:100px;padding:15px 30px;font-size:15px;font-weight:600;cursor:pointer;text-decoration:none;display:inline-block;box-shadow:0 6px 32px var(--pg);transition:all .25s}
.btn-p:hover{transform:translateY(-2px);box-shadow:0 10px 40px rgba(139,44,245,.45)}
.btn-w{display:inline-flex;align-items:center;gap:8px;background:rgba(37,211,102,.1);border:1px solid rgba(37,211,102,.3);color:#4ade80;border-radius:100px;padding:14px 26px;font-size:15px;font-weight:500;text-decoration:none;transition:all .25s}
.btn-w:hover{background:rgba(37,211,102,.18);transform:translateY(-1px)}
.scroll-hint{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:5px;animation:fadeUp 1s .9s ease both}
.scroll-line{width:1px;height:36px;background:linear-gradient(to bottom,transparent,var(--mu2));animation:sLine 2s infinite}
@keyframes sLine{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
.scroll-lbl{font-size:9px;color:var(--mu2);letter-spacing:2.5px;text-transform:uppercase}
.trust{padding:0 20px 50px;position:relative;z-index:1}
.trust-inner{max-width:500px;margin:0 auto;display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.tc{background:var(--s1);border:1px solid var(--bd);border-radius:14px;padding:18px 14px;display:flex;align-items:center;gap:11px;transition:all .28s}
.tc:hover{border-color:rgba(139,44,245,.28);transform:translateY(-2px)}
.tc-icon{font-size:20px;flex-shrink:0}
.tc-text{font-size:12px;font-weight:500;color:#bbb;line-height:1.35}
.tc-text strong{display:block;color:var(--text);font-size:13px;margin-bottom:1px}
.products{padding:20px 20px 60px;position:relative;z-index:1}
.sh{text-align:center;margin-bottom:30px}
.stag{display:inline-block;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--pl);background:rgba(139,44,245,.1);border:1px solid rgba(139,44,245,.2);border-radius:100px;padding:4px 14px;margin-bottom:12px}
.stitle{font-family:var(--fd);font-weight:800;font-size:clamp(22px,6vw,36px);letter-spacing:-.8px}
.pgrid{display:grid;grid-template-columns:1fr;gap:14px;max-width:520px;margin:0 auto}
.pc{background:var(--s1);border:1px solid var(--bd);border-radius:22px;overflow:hidden;cursor:pointer;transition:all .32s cubic-bezier(.25,.8,.25,1);position:relative}
.pc:hover{border-color:rgba(139,44,245,.32);transform:translateY(-4px);box-shadow:0 22px 55px rgba(0,0,0,.55),0 0 30px rgba(139,44,245,.1)}
.pimg{width:100%;aspect-ratio:16/10;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
.pimg svg{position:absolute;inset:0;width:100%;height:100%}
.pbadge{position:absolute;top:12px;left:12px;z-index:3;background:rgba(0,0,0,.65);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.12);color:#fff;border-radius:100px;padding:4px 12px;font-size:10px;font-weight:600;letter-spacing:.2px}
.pbadge.hot{background:rgba(239,68,68,.8);border-color:rgba(239,68,68,.4)}
.pbadge.new{background:rgba(139,44,245,.8);border-color:rgba(139,44,245,.4)}
.pbadge.best{background:rgba(234,179,8,.8);border-color:rgba(234,179,8,.4)}
.pbadge.eco{background:rgba(34,197,94,.8);border-color:rgba(34,197,94,.4)}
.ptag{position:absolute;top:12px;right:12px;z-index:3;background:rgba(34,197,94,.18);border:1px solid rgba(34,197,94,.4);color:#4ade80;border-radius:100px;padding:3px 10px;font-size:10px;font-weight:700}
.pinfo{padding:16px 18px 18px}
.pname{font-family:var(--fd);font-weight:800;font-size:17px;letter-spacing:-.3px;margin-bottom:4px}
.pdesc{font-size:12px;color:var(--mu);line-height:1.4;margin-bottom:14px}
.prow{display:flex;align-items:center;justify-content:space-between;gap:10px}
.pprices{display:flex;flex-direction:column}
.pold{font-size:11px;color:var(--mu2);text-decoration:line-through}
.pnew{font-family:var(--fd);font-weight:800;font-size:22px;letter-spacing:-.5px}
.pnew span{font-size:14px;font-weight:500}
.psave{font-size:11px;color:var(--green);font-weight:600;margin-top:1px}
.pbuy{display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,#25D366,#1aab53);color:#fff;border:none;border-radius:100px;padding:11px 18px;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;flex-shrink:0;box-shadow:0 4px 18px rgba(37,211,102,.3);transition:all .22s;text-decoration:none}
.pbuy:hover{transform:scale(1.04);box-shadow:0 6px 24px rgba(37,211,102,.45)}
.pbanner{margin:0 20px 50px;max-width:480px;margin-left:auto;margin-right:auto;background:linear-gradient(135deg,rgba(139,44,245,.14),rgba(255,107,0,.09));border:1px solid rgba(139,44,245,.28);border-radius:18px;padding:22px 20px;display:flex;align-items:center;gap:14px;position:relative;z-index:1;overflow:hidden}
.pbanner::before{content:'';position:absolute;top:-40px;right:-40px;width:150px;height:150px;background:radial-gradient(circle,rgba(139,44,245,.18),transparent 70%)}
.pb-icon{font-size:34px;flex-shrink:0}
.pb-text h3{font-family:var(--fd);font-weight:800;font-size:15px;margin-bottom:3px}
.pb-text p{font-size:12px;color:var(--mu);line-height:1.5}
.pb-text strong{color:#c084fc}
.stats{padding:0 20px 50px;position:relative;z-index:1}
.stats-inner{max-width:500px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.sc{background:var(--s1);border:1px solid var(--bd);border-radius:14px;padding:18px 12px;text-align:center}
.sc-num{font-family:var(--fd);font-weight:900;font-size:24px;letter-spacing:-1px;background:linear-gradient(135deg,#c084fc,var(--ol));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.sc-lbl{font-size:11px;color:var(--mu);margin-top:3px;line-height:1.3}
.community{padding:10px 20px 60px;position:relative;z-index:1}
.comm-card{max-width:500px;margin:0 auto;background:var(--s1);border:1px solid var(--bd);border-radius:22px;padding:36px 22px;text-align:center;overflow:hidden;position:relative}
.comm-card::before{content:'';position:absolute;top:-50px;left:50%;transform:translateX(-50%);width:240px;height:180px;background:radial-gradient(ellipse,rgba(139,44,245,.14),transparent 70%)}
.comm-stars{color:#FBBF24;font-size:17px;margin-bottom:12px;letter-spacing:2px}
.comm-title{font-family:var(--fd);font-weight:800;font-size:20px;letter-spacing:-.5px;margin-bottom:11px;line-height:1.25}
.comm-text{color:#999;font-size:14px;line-height:1.7;max-width:320px;margin:0 auto 22px}
.comm-btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#25D366,#128C7E);color:#fff;border:none;border-radius:100px;padding:13px 26px;font-size:14px;font-weight:600;cursor:pointer;text-decoration:none;transition:all .25s;box-shadow:0 4px 22px rgba(37,211,102,.25)}
.comm-btn:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(37,211,102,.4)}
footer{background:var(--s1);border-top:1px solid var(--bd);padding:34px 20px 26px;text-align:center;position:relative;z-index:1}
.flogo{display:flex;align-items:center;justify-content:center;gap:9px;margin-bottom:18px}
.fmark{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,var(--purple),var(--orange));display:flex;align-items:center;justify-content:center;font-family:var(--fd);font-weight:900;font-size:11px;color:#fff}
.fbrand{font-family:var(--fd);font-weight:800;font-size:14px;letter-spacing:.5px}
.socials{display:flex;justify-content:center;gap:10px;margin-bottom:18px}
.sb{width:42px;height:42px;border-radius:50%;background:var(--s2);border:1px solid var(--bd);display:flex;align-items:center;justify-content:center;text-decoration:none;transition:all .2s}
.sb:hover{border-color:rgba(139,44,245,.4);transform:translateY(-2px)}
.finfo{font-size:12px;color:var(--mu);line-height:1.9}
.fcopy{font-size:11px;color:var(--mu2);margin-top:8px}
@keyframes fadeUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
.reveal{opacity:0;transform:translateY(26px);transition:opacity .65s ease,transform .65s ease}
.reveal.visible{opacity:1;transform:translateY(0)}
@media(max-width:360px){h1{font-size:26px}.trust-inner{grid-template-columns:1fr}.stats-inner{grid-template-columns:repeat(2,1fr)}}
@media(min-width:520px){.pgrid{grid-template-columns:repeat(2,1fr)}.pc.feat{grid-column:1/-1}.pc.feat .pimg{aspect-ratio:21/9}}
</style>
</head>
